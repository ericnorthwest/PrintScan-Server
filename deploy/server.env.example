PRINTSCAN_DATA_DIR=/var/lib/printscan-server
PRINTSCAN_DATABASE_PATH=/var/lib/printscan-server/printscan.sqlite3
PRINTSCAN_SPOOL_DIR=/var/lib/printscan-server/spool
PRINTSCAN_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.10
PRINTSCAN_COOKIE_SECURE=false
PRINTSCAN_SESSION_TTL=43200
PRINTSCAN_MAX_UPLOAD_BYTES=33554432
PRINTSCAN_LP_BIN=lp
PRINTSCAN_LPSTAT_BIN=lpstat
PRINTSCAN_SCANIMAGE_BIN=scanimage
